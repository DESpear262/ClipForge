{
  "package": {
    "productName": "ClipForge",
    "version": "0.1.0-mvp"
  },
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "tauri": {
    "windows": [],
    "allowlist": {
      "all": false,
      "dialog": { "open": true, "save": true },
      "fs": {
        "readFile": true,
        "writeFile": true,
        "exists": true,
        "createDir": true,
        "scope": ["**"]
      },
      "path": {
        "all": true
      },
      "protocol": {
        "asset": true,
        "assetScope": ["**"]
      },
      "shell": { "open": true }
    },
    "bundle": {
      "identifier": "com.clipforge.app",
      "active": true,
      "targets": ["nsis"],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "resources": [
        "bin/ffmpeg.exe",
        "bin/ffprobe.exe"
      ]
    },
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: blob:; media-src 'self' asset: data: blob:; connect-src 'self' http://localhost:1420 asset:;"
    }
  }
}
