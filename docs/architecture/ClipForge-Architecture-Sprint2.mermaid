flowchart LR
    %% ===== Core Nodes =====
    user["User"]
    react["React UI (Vite + TS)"]
    aiPanel["AI Tools Panel"]
    recorder["Recorder Panel"]
    timeline["Konva Timeline (Multi Track)"]
    player["HTML5 Video Player"]
    state["Project State (JSON)"]
    tauri["Tauri v1 Shell (Rust)"]
    resolver["Path Resolver"]
    allow["Allowlist: fs, dialog, path, process"]
    ffprobe["FFprobe (Sidecar)"]
    ffmpeg["FFmpeg (Sidecar)"]
    whisper["Whisper (Local or API)"]
    openai["OpenAI 4o mini (API)"]
    fs["Windows File System"]
    webview["WebView2 Runtime"]

    %% ===== High Level Wiring =====
    user --> react
    react --> recorder
    react --> timeline
    react --> player
    react --> aiPanel
    react --> tauri
    tauri --- webview
    tauri --> resolver
    tauri --> allow
    allow --> fs

    %% ===== Recording =====
    subgraph "Recording"
        recorder --> tauri
        tauri --> ffmpeg
        tauri --> ffprobe
        recorder --> state
    end

    %% ===== Editing Timeline =====
    subgraph "Editing Timeline"
        timeline --> state
        state --> timeline
        player --> fs
        timeline --> player
    end

    %% ===== AI System =====
    subgraph "AI System"
        aiPanel --> whisper
        whisper --> aiPanel
        aiPanel --> openai
        openai --> aiPanel
        aiPanel --> state
        state --> aiPanel
        aiPanel --> timeline
    end

    %% ===== Export =====
    subgraph "Export"
        react --> ffmpeg
        ffmpeg --> fs
        ffmpeg --> react
    end

    %% ===== Platform =====
    subgraph "Platform"
        tauri
        resolver
        allow
        webview
        fs
    end
